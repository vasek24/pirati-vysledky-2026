{
  "rewrites": [
    {
      "source": "/:slug(praha|praha-[a-z0-9-]+|brno|ostrava|plzen)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/volby.js": {
      "maxDuration": 30
    },
    "api/prehled.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
