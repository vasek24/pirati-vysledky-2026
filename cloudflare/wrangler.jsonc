// Cloudflare Worker pro pirati-vysledky-2026 — viz cloudflare/README.md.
// Nasazuje GitHub Action (.github/workflows/deploy.yml) při každém pushi do
// main; ručně: npm run deploy (v této složce). Secret: GITHUB_TOKEN (brouk).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pirati-volby-zaloha",
  "account_id": "741febb7a315a409b83e5a9a1b62954d",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS"
  },
  // Screenshoty z nahlášených chyb (brouk), servíruje je worker na /hlaseni/*
  // Namespace zakládá Task 5; do té doby je id záměrně neplatné, takže
  // nechtěný `wrangler deploy` selže a na nic nesáhne.
  "kv_namespaces": [{ "binding": "HLASENI", "id": "CREATE-IN-TASK-5" }],
  // Návštěvnost: anonymní počty (worker.js track()); dataset se založí sám
  // při prvním zápisu, čte se přes SQL API (Account Analytics Read)
  "analytics_engine_datasets": [{ "binding": "STATS", "dataset": "pirati_vysledky_2026" }],
  "durable_objects": {
    "bindings": [{ "name": "FEED", "class_name": "Feed" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Feed"] }],
  // Vlastní doména (zatím běží jen na workers.dev)
  // "routes": [{ "pattern": "volby.example.cz", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Warm-up první třídy feedů (feedClasses.js) — jen produkce, ne staging
  "triggers": { "crons": ["* * * * *"] },

  // Staging: samostatný skript (vlastní Durable Object storage a KV), jen
  // workers.dev, bez routes a cronů. Každé nasazení jde nejdřív sem
  // (`wrangler deploy --env staging`), produkce až po kontrolách na stagingu.
  // Wrangler nededí assets, KV, DO, migrace ani analytics — proto jsou níže.
  "env": {
    "staging": {
      "name": "pirati-volby-zaloha-staging",
      // triggers se dědí z produkce — prázdný seznam vypne cron na stagingu
      "triggers": { "crons": [] },
      "workers_dev": true,
      "assets": {
        "directory": "../dist",
        "binding": "ASSETS"
      },
      // Vlastní namespace zakládá Task 5; do té doby neplatné id (viz výše).
      "kv_namespaces": [{ "binding": "HLASENI", "id": "CREATE-IN-TASK-5" }],
      "analytics_engine_datasets": [{ "binding": "STATS", "dataset": "pirati_vysledky_2026" }],
      "durable_objects": {
        "bindings": [{ "name": "FEED", "class_name": "Feed" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Feed"] }]
    }
  }
}
